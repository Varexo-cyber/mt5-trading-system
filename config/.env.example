# Copy to config/.env and fill in. config/.env is gitignored — keep it that way.
#
# The system reads credentials ONLY from the environment. They never appear in
# config.yaml, in the journal, or in a log line.

# --- MetaTrader 5 account ---------------------------------------------------
MT5_LOGIN=12345678
MT5_PASSWORD=your-password-here
MT5_SERVER=YourBroker-Demo

# Optional: explicit path to the terminal when several are installed.
# MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# --- Alerts (Phase 7, optional) ---------------------------------------------
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# DISCORD_WEBHOOK_URL=

# --- Economic calendar providers (Phase 3) ----------------------------------
# Most free feeds need no key. Fill in only what your chosen provider requires.
# CALENDAR_API_KEY=

# --- Optional AI veto gate -------------------------------------------------
# API subscriptions are billed separately from ChatGPT/Claude chat plans.
# Never paste these values into chat, config.yaml, logs, or source code.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- Rio Traders / MacroDroid bridge --------------------------------------
# Generate this locally with setup_rio_bridge.cmd; never copy a real token
# into this tracked template.
# RIO_SIGNAL_TOKEN=

# --- Long-term memory (Postgres / Neon) -------------------------------------
# Optional. Without it the system keeps its short memory in
# runtime/trading_memory.json exactly as before; with it, every decision,
# every guard action and every lesson survives the machine and stays
# queryable for the life of the account.
#
# Nothing read from this database may move a risk limit, a threshold or a lot
# size. It is evidence and prompt context. See brain/store.py.
#
# Needs the driver:  pip install "psycopg[binary]"
# Then apply the schema once:  python scripts/verify_brain.py
# NEON_DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
