# Secrets — never commit
config/.env
.env

# ...but the template is tracked on purpose.
!config/.env.example

# Runtime state
logs/
*.log
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
data_cache/
# The live calendar cache is rewritten every thirty minutes by the running
# system. Tracked, it left the working tree permanently dirty -- which is
# cosmetic until `auto_update.py` refuses to touch a dirty tree, and then it
# blocks every unattended update forever. The archive next to it is committed
# on purpose: it is the historical record the replay reads, it grows only when
# the weekly task appends to it, and it is worth surviving a rebuilt VPS.
data/calendar/cache.json
STOP
runtime/

# Python
__pycache__/
*.py[cod]
.venv/
.venv-live/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# `weekend.cmd` schrijft hier zijn rapporten naartoe. Die bevatten posities,
# saldi en tickets van een echte rekening en horen niet in een repository.
reports/

# Ten years of M15 bars used by scripts/measure_edges.py. 118 MB of public
# HistData; the script header says how to refetch it.
data/m15/

# Research bars for scripts/lab (about 750 MB of public HistData).
# scripts/lab/data.py says how to refetch them.
data/research/

# Downloaded bars, filled by ophalen.cmd.
#
# M15 and slower ARE committed on purpose -- about 25 MB over sixteen markets
# and 180 days -- because the point of the store is that the analysis can
# happen anywhere without a terminal, and bars that live only on one VPS
# cannot do that. `deel.cmd` pushes them.
#
# M1 and M5 are not. They are three quarters of the bars and roughly 120 MB,
# they are the clocks the cost wall refuses anyway, and a repository should
# not carry them forever. `ophalen.cmd` refetches them in one command.
data/history/*/M1.npz
data/history/*/M5.npz
